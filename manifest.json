{
  "manifest_version": 3,
  "name": "Huy's File Downloader",
  "version": "1.2.1",
  "description": "Find file links on the current page and download selected categories.",
  "permissions": ["activeTab", "scripting", "downloads", "storage"],
  "action": {
    "default_title": "Huy's File Downloader",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
